<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions, kept to the minimum PromptForge needs. Used only when signing with a
  Developer ID (ad-hoc builds don't enable the hardened runtime).
  - allow-jit: the .NET runtime compiles code at run time.
  - audio-input: voice dictation records the microphone.
  No sandbox: a sandboxed app can't use the Accessibility API to copy and paste in other apps.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
